{
  "id": "./",
  "name": "Bíblia Lumen",
  "short_name": "Lumen",
  "description": "Bíblia, comentários, confissões, devocionais, estudos e anotações — offline, rápida e sempre atualizada.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./?origem=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f4efdf",
  "theme_color": "#2f4d3d",
  "categories": [
    "books",
    "education",
    "lifestyle"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Ler a Bíblia",
      "short_name": "Bíblia",
      "url": "./?area=0",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Pesquisar",
      "short_name": "Pesquisar",
      "url": "./?acao=pesquisar",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Devocional de hoje",
      "short_name": "Devocional",
      "url": "./?acao=devocionais",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
