{
  "name": "km-bible-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Bíblia Reformada — PWA leve, offline e atualizável (React + TypeScript + Vite).",
  "scripts": {
    "data": "python3 scripts/build_data.py",
    "fonts": "python3 scripts/build_fonts.py",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:app": "tsc --noEmit && vite build && node scripts/finalize_build.mjs",
    "build": "npm run data && npm run fonts && npm run build:app",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "publish:pages": "bash scripts/publish_gh_pages.sh"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.19",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "lucide-react": "0.577.0",
    "marked": "14.1.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "1.14.2",
    "fake-indexeddb": "6.2.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "jsdom": "25.0.1",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
